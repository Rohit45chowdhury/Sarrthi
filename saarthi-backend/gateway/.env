# same port your frontend already used for the monolith
PORT=3000

USER_SERVICE_URL=http://127.0.0.1:3001
CAPTAIN_SERVICE_URL=http://127.0.0.1:3002
RIDE_SERVICE_URL=http://127.0.0.1:3003
MAPS_SERVICE_URL=http://127.0.0.1:3004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3005

# comma separated frontend origins. Leave empty in dev to allow any origin.
CORS_ORIGINS=http://localhost:5173

# set true when running behind nginx / a cloud load balancer
TRUST_PROXY=false

RATE_LIMIT_PER_MIN=300
